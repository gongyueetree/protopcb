{
  "name": "protopcb",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Circuit Canvas — 电子产品早期架构与PCB预布局智能工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run scan:secrets && npm run typecheck && npm run lint && npm run check:cycles && npm run test && npm run build",
    "check:cycles": "madge --circular --extensions ts,tsx src",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "nanoid": "^5.0.9",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "madge": "^8.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
