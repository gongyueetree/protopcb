# ============================================================
# 硬件原型工坊 / Circuit Canvas —— 环境变量样例
#
# 安全约定（CI 会用 scripts/scan-secrets.mjs 强制检查）：
#   * 任何密钥都**不能**带 VITE_ 前缀 —— 带 VITE_ 的变量会被打进前端 bundle，
#     等于把 Key 公开发布。密钥只在 api/ 下的服务端函数里读取。
#   * 本文件只放占位值，真实值配置在 Vercel 项目设置里。
# ============================================================

# ---------- 前端（会进 bundle，只能放非敏感配置）----------
VITE_APP_MODE=demo              # demo | integrated
# VITE_API_BASE_URL=            # 自建后端时才需要

# ---------- AI ----------
GEMINI_API_KEY=                 # 必填才能用 AI 方案/子电路/向导提取
# GEMINI_MODEL=gemini-2.0-flash # 可选：强制指定模型

# ---------- 分销商 / 元器件库 ----------
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
# ARROW_LOGIN=
# ARROW_API_KEY=
# ELEMENT14_API_KEY=
# CECPORT_API_KEY=              # 国产渠道，预留：配置后自动启用
# B1B_API_KEY=                  # 国产渠道，预留：配置后自动启用

# ---------- ezPLM ----------
EZPLM_API_KEY=
# EZPLM_JWT_SECRET=             # 与 ds2kicad 实例的同名变量一致
# DS2KICAD_URL=                 # datasheet 提取引擎地址

# ---------- 服务端防护（均有默认值，按需覆盖）----------
# API_RATE_PER_MIN=30           # 每个调用方每分钟请求数
# API_RATE_WINDOW_MS=60000
# API_MAX_CONCURRENT=4          # 单调用方并发上限
# API_MAX_BODY_BYTES=8388608    # 请求体上限 8MB
# API_TIMEOUT_MS=30000
# AI_MAX_PROMPT_CHARS=24000     # AI prompt 长度上限
# AI_MAX_FILE_BYTES=4194304     # AI 附件（PDF/图片）上限 4MB
# ALLOW_HTTP_FETCH=0            # 1 = 允许抓取 http:// 链接（生产建议保持 0）
