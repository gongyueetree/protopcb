# 运行模式: demo | standalone | integrated
VITE_APP_MODE=demo

# standalone/integrated 模式下后端地址
# VITE_API_BASE_URL=http://localhost:8787/api

# Gemini AI 真实方案生成（配置后 AI 生成走 Gemini，否则用内置 Mock）
# 在 Vercel: Settings → Environment Variables 添加同名变量后 Redeploy
# VITE_GEMINI_API_KEY=你的GoogleAIStudio密钥

# ezPLM 元器件库实时接入（服务端专用，切勿加 VITE_ 前缀！）
# 在 Vercel: Settings → Environment Variables 添加 EZPLM_API_KEY 后 Redeploy
# Key 由签名代理 /api/ezplm 在服务端使用（HMAC-SHA256 请求签名），不会进入前端代码
# EZPLM_API_KEY=你的ezPLM密钥
